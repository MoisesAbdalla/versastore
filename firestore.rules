rules_version = '2';

// Rules da dashboard administrativa (specs/003-admin-dashboard/contracts/firestore.md).
// Rollout concluído em T030a: leitura pública de products restrita a
// (status == "ativo" && deleted == false) — exige backfill dos produtos legados
// ANTES do deploy (ver comentário no match /products).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /products/{productId} {
      // Rule final (T030a): a loja só lê produtos ativos e não excluídos.
      // ATENÇÃO: só deployar após rodar o backfill (window.backfillProducts()
      // em dev, logado como admin) — produtos legados sem os campos
      // status/deleted seriam negados por esta rule.
      allow read: if isAdmin()
        || (resource.data.status == "ativo" && resource.data.deleted == false);
      allow create, delete: if isAdmin();
      // Baixa de estoque pela transação de criação de pedido do cliente
      // (feature 009): só campos de estoque, decremental e não-negativo. A rule
      // não valida o valor EXATO do decremento (Firestore não lê o pedido criado
      // na mesma transação) — dívida fechada no M4b (Function + custom claims).
      allow update: if isAdmin()
        || ( isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stock', 'totalStock', 'variations'])
          && request.resource.data.totalStock <= resource.data.totalStock
          && request.resource.data.totalStock >= 0 );
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      // Checkout (feature 009): o cliente DONO cria o próprio pedido, só no
      // status inicial e sem agregados aplicados. Avançar status segue admin-only.
      allow create: if isAdmin()
        || ( isSelf(request.resource.data.customerId)
          && request.resource.data.status == "aguardando_pagamento"
          && request.resource.data.aggregatesApplied == false );
      allow delete: if isAdmin();
      // Itens, número, cliente (id/e-mail) e data são imutáveis após a criação
      // (defesa em profundidade; a validação principal é do orderService).
      // Os campos desnormalizados de exibição/busca do cliente podem ser
      // corrigidos por admin (backfill da busca por nome/e-mail).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusHistory', 'trackingCode', 'internalNotes',
                    'customerName', 'customerNameLower', 'customerEmailLower',
                    // Aplicados na transição `pago` (feature 009): receita/totais
                    // do cliente contam quando o pedido é pago.
                    'aggregatesApplied', 'statsDay']);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      // Registro pela loja: o usuário cria o próprio doc, sempre como customer.
      allow create: if isAdmin()
        || (isSelf(userId) && request.resource.data.role == "customer");
      // Escalação de privilégio bloqueada: o próprio usuário nunca altera role
      // nem os agregados mantidos pelas transações de pedido.
      allow update: if isAdmin()
        || (isSelf(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('orderCount', 0) == resource.data.get('orderCount', 0)
          && request.resource.data.get('totalSpent', 0) == resource.data.get('totalSpent', 0));
      allow delete: if isAdmin();
    }

    match /dailyStats/{day} {
      allow read, write: if isAdmin();
    }

    match /counters/{counterId} {
      // O cliente lê e incrementa (+1) o contador de pedidos na transação de
      // criação (feature 009); admin faz qualquer escrita.
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin()
        || ( isSignedIn()
          && request.resource.data.current == (resource != null ? resource.data.current : 0) + 1 );
    }

    // Aparência da Home (feature 004): a loja lê as imagens customizadas
    // (leitura pública, como products/categories); só admin escreve.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
